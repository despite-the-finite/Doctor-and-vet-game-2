# ─────────────────────────────────────────────────────────────────────────────
#  Little Heroes Hospital — environment
#
#  Copy this file to `.env` and fill it in:
#
#      cp .env.example .env
#
#  `.env` is git-ignored. NEVER commit a real key, and never put one anywhere
#  under src/ — everything in src/ is served to the browser as-is.
# ─────────────────────────────────────────────────────────────────────────────

# Your ElevenLabs API key. Only `npm run generate-voices` and
# `npm run voices:list` ever read it; the game itself never calls ElevenLabs,
# it just plays the MP3s those scripts wrote into public/audio/.
#
# Get one at https://elevenlabs.io → your profile → API keys
ELEVENLABS_API_KEY=

# Optional. The model used for generation. Defaults to eleven_v3, the most
# expressive one — it understands the performance tags ([warmly], [excited]…)
# that src/dialogue/emotions.js adds. Alternatives:
#   eleven_multilingual_v2   steadier, no performance tags
#   eleven_turbo_v2_5        faster and cheaper
#   eleven_flash_v2_5        cheapest
# (Or pass --model on the command line.)
# ELEVENLABS_MODEL=eleven_v3
